{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        }
    ],
    "functions": {
        "api/**/*.js": {
            "memory": 1024,
            "maxDuration": 60
        }
    },
    "routes": [
        {
            "src": "/api/playlist",
            "dest": "/api/index.js"
        },
        {
            "src": "/api/stream/(.*)",
            "dest": "/index.js"
        },
        {
            "src": "/",
            "dest": "/index.js"
        }
    ]
}